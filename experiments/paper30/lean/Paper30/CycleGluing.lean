import Mathlib.Logic.Equiv.Defs
import Paper30.OrbitReduction

/-!
# Cycle gluing as an exact quotient

Points in one relative-return cycle are treated as internally controllable.
The other branch permutation supplies symmetric inter-cycle edges. The exact
component statement is then an instance of relation-valued orbit reduction.
-/

namespace Rime.Paper30

universe u v

variable {Point : Type u} {Cycle : Type v}

/-- Point dynamics generated by movement inside one cycle and by `a^{±1}`. -/
def PointStep (cycleOf : Point → Cycle) (a : Equiv.Perm Point)
    (x y : Point) : Prop :=
  cycleOf x = cycleOf y ∨ a x = y ∨ a.symm x = y

/-- An undirected edge between two relative-return cycles. -/
def GluingEdge (cycleOf : Point → Cycle) (a : Equiv.Perm Point)
    (left right : Cycle) : Prop :=
  ∃ x y, cycleOf x = left ∧ cycleOf y = right ∧ (a x = y ∨ a y = x)

def CycleStep (cycleOf : Point → Cycle) (a : Equiv.Perm Point) :
    Cycle → Cycle → Prop :=
  QuotStep cycleOf (PointStep cycleOf a)

theorem cycle_fiber_internal (cycleOf : Point → Cycle) (a : Equiv.Perm Point)
    {x y : Point} (h : cycleOf x = cycleOf y) :
    Reach (PointStep cycleOf a) x y :=
  Reach.single (Or.inl h)

/-- Point reachability is exactly reachability in the cycle-gluing quotient. -/
theorem exact_cycle_gluing_reachability
    (cycleOf : Point → Cycle) (a : Equiv.Perm Point) (x y : Point) :
    Reach (CycleStep cycleOf a) (cycleOf x) (cycleOf y) ↔
      Reach (PointStep cycleOf a) x y := by
  exact exact_quotient_reachability cycleOf (PointStep cycleOf a)
    (cycle_fiber_internal cycleOf a) x y

/-- On represented cycles, one quotient edge is equality or a gluing edge. -/
theorem cycleStep_iff_eq_or_gluing
    (cycleOf : Point → Cycle) (a : Equiv.Perm Point) (x y : Point) :
    CycleStep cycleOf a (cycleOf x) (cycleOf y) ↔
      cycleOf x = cycleOf y ∨ GluingEdge cycleOf a (cycleOf x) (cycleOf y) := by
  constructor
  · rintro ⟨u, v, hu, hv, huv⟩
    rcases huv with hsame | hforward | hbackward
    · exact Or.inl (hu.symm.trans (hsame.trans hv))
    · exact Or.inr ⟨u, v, hu, hv, Or.inl hforward⟩
    · have hreverse : a v = u := by
        have applied := congrArg a hbackward
        simpa using applied.symm
      exact Or.inr ⟨u, v, hu, hv, Or.inr hreverse⟩
  · intro h
    rcases h with hsame | hedge
    · exact ⟨x, y, rfl, rfl, Or.inl hsame⟩
    · rcases hedge with ⟨u, v, hu, hv, hforward | hreverse⟩
      · exact ⟨u, v, hu, hv, Or.inr (Or.inl hforward)⟩
      · have hbackward : a.symm u = v := by
          have applied := congrArg a.symm hreverse
          simpa using applied.symm
        exact ⟨u, v, hu, hv, Or.inr (Or.inr hbackward)⟩

end Rime.Paper30
