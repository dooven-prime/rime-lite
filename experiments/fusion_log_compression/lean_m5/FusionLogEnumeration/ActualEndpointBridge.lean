import FusionLogSchedule.LiteralClassification
import FusionLogEnumeration.DeletionFiber
import FusionLogEnumeration.EndpointGeometry

namespace FusionLogEnumeration

open RegisteredAbsorptionChains FusionLogSchedule FusionLogReplay FusionLogInterpretation

variable {α : Type*} [DecidableEq α]

/-- A marked packet circle together with its actual literal initial placement.
The named placement fixes the physical sites and the positive cyclic order;
`circleBlocks` identifies each M5 packet with the corresponding literal
source packet. -/
structure LiteralPacketStart (C : MarkedCircle α) (n : ℕ)
    [NeZero n] [NeZero C.rank] where
  initial : Placement n (Finset α)
  named : LegalNamedPlacement n C.rank α
  initial_eq_named : initial = named.placed
  circleBlocks : ∀ i : Fin C.rank,
    named.block (i.val : ZMod C.rank) = C.packets[i].atoms
  positiveOrder : named.PositivelyOrdered

namespace LiteralPacketStart

variable {C : MarkedCircle α} {n : ℕ} [NeZero n] [NeZero C.rank]

theorem occupied_nonempty (start : LiteralPacketStart C n) :
    (occupiedSites start.initial).Nonempty := by
  refine ⟨start.named.position 0, ?_⟩
  rw [start.initial_eq_named]
  simp [occupiedSites, start.named.placed_at 0]

theorem packetPartition (start : LiteralPacketStart C n) :
    FusionLogSchedule.PacketPartition start.initial := by
  rw [start.initial_eq_named]
  exact FusionLogSchedule.packetPartition_of_named start.named

def execution (start : LiteralPacketStart C n) : Execution n α :=
  ⟨start.initial, none, []⟩

end LiteralPacketStart

/-- The dependent bridge object for one M5 schedule and one actual literal
endpoint. It keeps the M4-D schedule witness tied to the same initial literal
placement and the same complete event list. -/
structure ActualJointBridge {C : MarkedCircle α} {n d : ℕ}
    [NeZero n] [NeZero C.rank]
    (start : LiteralPacketStart C n) (path : Schedule C d)
    (target : Placement n (Finset α)) where
  schedule : AdmissibleSchedule start.initial start.occupied_nonempty path.records
  compatible : CompatibleEndpoint schedule target

/-- A reference endpoint generated by realizing the abstract M4-D trace.
Its physical coordinates are only a witness; its packet blocks and positive
cycle provide the canonical terminal order used by every endpoint choice.
The event list is retained as a parameter without forcing the reference
placement to depend on a chosen raw execution word. -/
structure ScheduleTerminalReferenceForLog {C : MarkedCircle α} {n : ℕ}
    [NeZero n] [NeZero C.rank]
    (start : LiteralPacketStart C n)
    (events : List (FusionRecord α))
    (schedule : AdmissibleSchedule start.initial start.occupied_nonempty events) where
  placed : Placement n (Finset (ZMod n))
  ordered : SourceOrdered placed
  packets : packetSet placed = schedule.last

namespace ScheduleTerminalReferenceForLog

variable {C : MarkedCircle α} {n : ℕ}
    [NeZero n] [NeZero C.rank]
    {start : LiteralPacketStart C n} {events : List (FusionRecord α)}
    {schedule : AdmissibleSchedule start.initial start.occupied_nonempty events}

noncomputable def ofAdmissible (hn : 3 ≤ n)
    (schedule : AdmissibleSchedule start.initial start.occupied_nonempty events) :
    ScheduleTerminalReferenceForLog start events schedule := by
  let source : Execution n (ZMod n) :=
    ⟨canonicalPlacement start.initial start.occupied_nonempty, none, []⟩
  have hordered : SourceOrdered source.placed :=
    canonicalPlacement_ordered start.initial start.occupied_nonempty
  let hreal : ∃ word : List Letter,
      eventTrace ∅ source word = schedule.indexEvents ∧
      SourceOrdered (run ∅ source word).placed ∧
      packetSet (run ∅ source word).placed = schedule.last :=
    schedule.abstractTrace.realize ∅ source hn hordered (by rfl)
  let word := Classical.choose hreal
  have hspec := Classical.choose_spec hreal
  exact ⟨(run ∅ source word).placed, hspec.2.1, hspec.2.2⟩

noncomputable def rank (reference : ScheduleTerminalReferenceForLog start events schedule) : ℕ :=
  (placedBlocks reference.placed).card

theorem rank_positive (reference : ScheduleTerminalReferenceForLog start events schedule) :
    0 < reference.rank :=
  sourceOrdered_blocks_card_pos reference.placed reference.ordered

instance rank_neZero
    (reference : ScheduleTerminalReferenceForLog start events schedule) :
    NeZero reference.rank := ⟨Nat.ne_of_gt reference.rank_positive⟩

noncomputable def named
    (reference : ScheduleTerminalReferenceForLog start events schedule) :
    LegalNamedPlacement n reference.rank (ZMod n) := by
  letI : NeZero (placedBlocks reference.placed).card :=
    ⟨Nat.ne_of_gt (sourceOrdered_blocks_card_pos reference.placed reference.ordered)⟩
  exact canonicalLegalNamed reference.placed reference.placed
    reference.ordered reference.ordered rfl

theorem named_positive
    (reference : ScheduleTerminalReferenceForLog start events schedule) :
    reference.named.PositivelyOrdered := by
  letI : NeZero (placedBlocks reference.placed).card :=
    ⟨Nat.ne_of_gt (sourceOrdered_blocks_card_pos reference.placed reference.ordered)⟩
  exact canonicalLegalNamed_positive reference.placed reference.placed
    reference.ordered reference.ordered rfl

noncomputable def cycle (reference : ScheduleTerminalReferenceForLog start events schedule) :
    LiteralPacketCycle reference.rank (ZMod n) := by
  letI : NeZero (placedBlocks reference.placed).card :=
    ⟨Nat.ne_of_gt (sourceOrdered_blocks_card_pos reference.placed reference.ordered)⟩
  exact LiteralPacketCycle.ofNamed reference.named

end ScheduleTerminalReferenceForLog

/- Every occupied-site/anchor choice, when read in the terminal packet cycle,
is statically compatible with the very schedule that determined that cycle. -/
theorem terminalCycle_coordinates_compatible
    {C : MarkedCircle α} {n : ℕ} [NeZero n] [NeZero C.rank]
    {start : LiteralPacketStart C n} {events : List (FusionRecord α)}
    {schedule : AdmissibleSchedule start.initial start.occupied_nonempty events}
    (hn : 3 ≤ n)
    (reference : ScheduleTerminalReferenceForLog start events schedule)
    (choice : EndpointChoices n reference.rank) :
    CompatibleEndpoint schedule
      (expandPlacement (siteLabels start.initial)
        (decodeEndpointChoices reference.cycle choice).placed) := by
  letI : NeZero reference.rank := ⟨Nat.ne_of_gt reference.rank_positive⟩
  letI : NeZero (placedBlocks reference.placed).card :=
    ⟨Nat.ne_of_gt (sourceOrdered_blocks_card_pos reference.placed reference.ordered)⟩
  let decoded := decodeEndpointChoices reference.cycle choice
  have hsameCycle : SameOrientedCyclicOrder reference.named decoded := by
    refine ⟨?_, reference.named_positive, decodeEndpointChoices_positive reference.cycle choice⟩
    funext i
    have hblock : reference.cycle.block = reference.named.block := rfl
    change reference.named.block i = reference.cycle.block i
    exact (congrFun hblock i).symm
  have hcompatible :=
    (index_compatible_iff_named_cycle reference.placed decoded.placed hn
      reference.ordered (show (placedBlocks reference.placed).card = reference.rank from rfl)).2
      ⟨reference.named, decoded, rfl, rfl, hsameCycle⟩
  refine ⟨decoded.placed, ?_, rfl⟩
  refine ⟨hcompatible.1, ?_⟩
  rw [hcompatible.2, reference.packets]

/- The endpoint fibre retains only its literal target. The M4-D witness is
   attached propositionally, rather than counted as additional endpoint data. -/
abbrev ActualLiteralEndpointFiber {C : MarkedCircle α} {n : ℕ}
    [NeZero n] [NeZero C.rank] (start : LiteralPacketStart C n)
    {d : ℕ} (path : Schedule C d) :=
  { target : Placement n (Finset α) //
    Nonempty (ActualJointBridge start path target) }

noncomputable def fixedScheduleTerminalReference
    {C : MarkedCircle α} {n d : ℕ} [NeZero n] [NeZero C.rank]
    (start : LiteralPacketStart C n) (path : Schedule C d)
    (schedule : AdmissibleSchedule start.initial start.occupied_nonempty path.records)
    (hn : 3 ≤ n) :
    ScheduleTerminalReferenceForLog start path.records schedule :=
  ScheduleTerminalReferenceForLog.ofAdmissible hn schedule

/-- Decode coordinates through the cycle canonically extracted from the
schedule's abstract trace. Compatibility is proved by the terminal cycle
theorem, not supplied as a field by the caller. -/
noncomputable def decodeFixedScheduleEndpoint
    {C : MarkedCircle α} {n d : ℕ} [NeZero n] [NeZero C.rank]
    (start : LiteralPacketStart C n) (path : Schedule C d)
    (schedule : AdmissibleSchedule start.initial start.occupied_nonempty path.records)
    (hn : 3 ≤ n)
    (choice : EndpointChoices n
      (fixedScheduleTerminalReference start path schedule hn).rank) :
    ActualLiteralEndpointFiber start path := by
  let reference := fixedScheduleTerminalReference start path schedule hn
  letI : NeZero reference.rank := ⟨Nat.ne_of_gt reference.rank_positive⟩
  refine ⟨expandPlacement (siteLabels start.initial)
    (decodeEndpointChoices reference.cycle choice).placed, ?_⟩
  exact ⟨⟨schedule, terminalCycle_coordinates_compatible hn reference choice⟩⟩

@[simp] theorem decodeFixedScheduleEndpoint_target
    {C : MarkedCircle α} {n d : ℕ} [NeZero n] [NeZero C.rank]
    (start : LiteralPacketStart C n) (path : Schedule C d)
    (schedule : AdmissibleSchedule start.initial start.occupied_nonempty path.records)
    (hn : 3 ≤ n)
    (choice : EndpointChoices n
      (fixedScheduleTerminalReference start path schedule hn).rank) :
    (decodeFixedScheduleEndpoint start path schedule hn choice).1 =
      expandPlacement (siteLabels start.initial)
        (decodeEndpointChoices
          (fixedScheduleTerminalReference start path schedule hn).cycle choice).placed := rfl

theorem actualJointBridge_iff_jointlyAttainable
    {C : MarkedCircle α} {n d : ℕ} [NeZero n] [NeZero C.rank]
    (F : Finset α) (start : LiteralPacketStart C n) (path : Schedule C d)
    (target : Placement n (Finset α)) (hn : 3 ≤ n) :
    Nonempty (ActualJointBridge start path target) ↔
      JointlyAttainable F start.execution path.records target := by
  constructor
  · rintro ⟨bridge⟩
    obtain ⟨word, logs, endpoint, _⟩ :=
      realize_admissible_schedule F start.execution path.records target hn
        start.occupied_nonempty bridge.schedule bridge.compatible
    exact ⟨word, logs, by simpa [LiteralPacketStart.execution] using endpoint⟩
  · rintro ⟨word, logs, endpoint⟩
    have certificate := actual_joint_certificate F start.execution word hn
      start.occupied_nonempty
    rw [logs, endpoint] at certificate
    obtain ⟨schedule, compatible⟩ := certificate
    exact ⟨⟨schedule, compatible⟩⟩

end FusionLogEnumeration
