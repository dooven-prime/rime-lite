  "theorem_contract": {
    "fixed_depth_stabilization": "At fixed depth d, the labelled zero-route set equals the generic integral prefix-pole profile for |F|>d outside E_d.",
    "fixed_field_automaton": "For each fixed finite field, reachable survivor subsets form a finite deterministic weighted automaton.",
    "generic_profile": "The generic depth-d zero-route set is determined by the rational prefix-pole equality relation; its count is candidate count minus the sum over words of one plus the number of pole classes.",
    "prefix_pole_classification": "A route survivor set is the intersection of forced prefix-pole singletons at zero sectors and prefix-pole complements at one sectors.",
    "rational_generating_functions": "For each fixed finite field F, B_F(z), N_F(z), and Z_F(z) are rational transfer-matrix series."
