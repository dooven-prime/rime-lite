{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rime-project.local/schemas/sofaudit/v1.0.schema.json",
  "title": "SOF Report Comparison Record Specification v1.0",
  "description": "Machine-readable contract for one admissible SOF comparison object, its induced audit signature, and a factual claim boundary.",
  "type": "object",
  "required": [
    "sofaudit_version",
    "report_type",
    "comparison_object",
    "audit_id",
    "system",
    "claim_status",
    "claim_note",
    "regime",
    "failure_mode",
    "reference",
    "target",
    "alignment",
    "comparison_specification",
    "signature",
    "failure_modes"
  ],
  "properties": {
    "sofaudit_version": {"const": "1.0"},
    "report_type": {"const": "sofaudit"},
    "comparison_object": {"const": "SOFReportComparison"},
    "audit_id": {"type": "string", "minLength": 1},
    "system": {"type": "string", "minLength": 1},
    "claim_status": {
      "enum": ["theorem", "evidence", "diagnostic", "proxy_only", "boundary", "failure", "negative_control"]
    },
    "claim_note": {"type": "string", "minLength": 1},
    "regime": {"enum": ["A", "B", "C"]},
    "failure_mode": {"type": "string", "minLength": 1},
    "domain": {
      "description": "Optional factual domain label for the aligned comparison.",
      "type": "string",
      "minLength": 1
    },
    "wall_note": {
      "description": "Optional factual qualification of a serialized wall-record comparison.",
      "type": "string",
      "minLength": 1
    },
    "comparison_role": {
      "description": "Optional semantic role for the comparison. The legacy failure_mode field remains required in v1.0.",
      "enum": ["failure_mode_control", "legitimate_transformation_control", "model_comparison", "behavioral_comparison"]
    },
    "reference": {"$ref": "#/$defs/reportReference"},
    "target": {"$ref": "#/$defs/reportReference"},
    "alignment": {
      "type": "object",
      "required": ["sector_alignment", "observable_alignment"],
      "properties": {
        "sector_alignment": {"$ref": "#/$defs/alignmentComponent"},
        "observable_alignment": {"$ref": "#/$defs/alignmentComponent"}
      },
      "additionalProperties": false
    },
    "comparison_specification": {
      "description": "Machine-readable serialization of Theta. It fixes the semantics required to compute every non-null audit coordinate.",
      "type": "object",
      "required": [
        "specification_id",
        "normalization",
        "metric",
        "depth_semantics",
        "thresholds",
        "parameter_synchronization",
        "aggregation"
      ],
      "properties": {
        "specification_id": {"const": "paper13-coordinatewise-v1"},
        "normalization": {"type": "object", "minProperties": 1},
        "metric": {"type": "object", "minProperties": 1},
        "depth_semantics": {"type": ["string", "object"]},
        "thresholds": {"type": "object", "minProperties": 1},
        "parameter_synchronization": {"type": "object", "minProperties": 1},
        "aggregation": {"type": "object", "minProperties": 1}
      },
      "additionalProperties": false
    },
    "signature": {
      "description": "Machine-readable serialization of the mathematical output Delta_audit.",
      "type": "object",
      "required": [
        "support_mismatch",
        "bridge_word_mismatch",
        "bridge_lie_mismatch",
        "depth_distortion",
        "frozen_disagreement",
        "constraint_violations",
        "action_response_failure",
        "wall_record_mismatch"
      ],
      "properties": {
        "support_mismatch": {"type": ["object", "null"]},
        "bridge_word_mismatch": {"type": ["object", "null"]},
        "bridge_lie_mismatch": {"type": ["object", "null"]},
        "depth_distortion": {"type": ["object", "null"]},
        "frozen_disagreement": {"type": ["object", "null"]},
        "constraint_violations": {"type": ["object", "null"]},
        "action_response_failure": {
          "description": "Compatibility field name for the native control-response mismatch coordinate; action refers to a source-system control, not a downstream intervention.",
          "type": ["object", "null"]
        },
        "wall_record_mismatch": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    },
    "failure_modes": {
      "type": "array",
      "items": {"type": ["string", "object"]},
      "uniqueItems": true
    },
    "transformation_contract": {
      "description": "Optional declared contract for a legitimate before/after transformation.",
      "type": "object",
      "required": ["contract_id", "intent", "allowed_changes", "preserved_invariants", "required_postconditions"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "intent": {"type": "string", "minLength": 1},
        "allowed_changes": {"type": ["array", "object"]},
        "preserved_invariants": {"type": "array", "items": {"type": "string"}},
        "required_postconditions": {"type": "array", "items": {"type": "string"}},
        "boundary": {"type": "string"}
      },
      "additionalProperties": true
    },
    "contract_evaluation": {
      "description": "Optional residual evaluation against a declared transformation contract; it does not overwrite the raw signature.",
      "type": "object",
      "required": ["status", "residual_violation_count", "residual_violations", "raw_change_summary"],
      "properties": {
        "status": {"enum": ["conforming", "nonconforming", "inconclusive"]},
        "residual_violation_count": {"type": "integer", "minimum": 0},
        "residual_violations": {"type": "array"},
        "raw_change_summary": {"type": "object", "minProperties": 1}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "alignmentComponent": {
      "description": "One leg-pair of the alignment into common retained coordinates. Identity, relabelling, partial, and declared aggregate alignments are permitted.",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "mapping": {"type": "object"},
        "reference_to_common": {"type": "object"},
        "target_to_common": {"type": "object"},
        "unmatched_reference": {"type": "array"},
        "unmatched_target": {"type": "array"}
      },
      "additionalProperties": true
    },
    "reportReference": {
      "type": "object",
      "required": ["report_id", "artifact", "label"],
      "properties": {
        "report_id": {"type": "string", "minLength": 1},
        "artifact": {"type": "string", "pattern": "^[^/\\\\]+\\.sofreport$"},
        "label": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "not": {
    "anyOf": [
      {"required": ["sofrs_version"]},
      {"required": ["audit_object"]},
      {"required": ["candidate"]},
      {"required": ["normalization"]},
      {"required": ["decision"]},
      {"required": ["action_semantics"]},
      {"required": ["action_set"]},
      {"required": ["selection"]},
      {"required": ["candidate_action"]},
      {"required": ["expected_effect"]},
      {"required": ["risk"]},
      {"required": ["policy_source"]}
    ]
  },
  "additionalProperties": false
}
