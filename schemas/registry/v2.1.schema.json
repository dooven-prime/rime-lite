          "enum": [
            "exact_realization",
            "represented_realization",
            "constructed_realization",
            "adapter_realization",
            "analogue_mapping",
            "proxy_only",
            "unresolved"
          ]
        },
        "evidence_role": {
          "enum": [
            "active_evidence",
            "negative_control",
            "proxy_evidence",
            "external_precedent",
            "historical_provenance",
            "research_candidate"
          ]
        },
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "strict_core": {
          "anyOf": [
            {"$ref": "#/$defs/strict_core"},
            {"type": "null"}
          ]
        },
        "analogue_core": {
          "anyOf": [
            {"$ref": "#/$defs/analogue_core"},
            {"type": "null"}
          ]
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/object"}
        },
        "semantic_conventions": {
          "type": "array",
          "items": {"$ref": "#/$defs/semantic_convention"}
        },
        "run_policies": {
          "type": "array",
          "items": {"$ref": "#/$defs/run_policy"}
        },
        "carriers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/carrier"}
        },
        "observable_channels": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/channel"}
        },
        "dynamics": {"$ref": "#/$defs/dynamics"},
        "artifact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "certificates": {
          "type": "array",
          "items": {"$ref": "#/$defs/certificate"}
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/finding"}
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/claim"}
        },
        "derivations": {
          "type": "array",
          "items": {"$ref": "#/$defs/derivation"}
        },
        "contract_refs": {"$ref": "#/$defs/contract_refs"},
        "metadata": {"$ref": "#/$defs/metadata"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"record_kind": {"const": "strict_sof"}},
            "required": ["record_kind"]
          },
          "then": {
            "properties": {
              "source_map_status": {
                "enum": [
                  "exact_realization",
                  "represented_realization",
                  "constructed_realization",
                  "adapter_realization"
                ]
              },
              "strict_core": {"$ref": "#/$defs/strict_core"},
              "analogue_core": {"const": null},
              "capabilities": {
                "properties": {
                  "sectorization": {
                    "properties": {"availability": {"const": "DECLARED"}}
                  },
                  "operator_carrier": {
                    "properties": {"availability": {"const": "DECLARED"}}
                  },
                  "diagnostic_analogue": {
                    "properties": {
                      "availability": {
                        "enum": ["NOT_DECLARED", "NOT_APPLICABLE"]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"record_kind": {"const": "diagnostic_analogue"}},
            "required": ["record_kind"]
          },
          "then": {
            "properties": {
              "source_map_status": {"enum": ["analogue_mapping", "proxy_only"]},
              "strict_core": {"const": null},
              "analogue_core": {"$ref": "#/$defs/analogue_core"},
              "capabilities": {
                "properties": {
                  "diagnostic_analogue": {
                    "properties": {"availability": {"const": "DECLARED"}}
                  }
                },
                "not": {
                  "anyOf": [
                    {"properties": {"sectorization": {"properties": {"availability": {"const": "DECLARED"}}}}},
                    {"properties": {"operator_carrier": {"properties": {"availability": {"const": "DECLARED"}}}}},
                    {"properties": {"operator_system": {"properties": {"availability": {"const": "DECLARED"}}}}},
                    {"properties": {"route_carrier": {"properties": {"availability": {"const": "DECLARED"}}}}},
                    {"properties": {"word_carrier": {"properties": {"availability": {"const": "DECLARED"}}}}},
                    {"properties": {"positive_associative_closure": {"properties": {"availability": {"const": "DECLARED"}}}}},
                    {"properties": {"observable_star_closure": {"properties": {"availability": {"const": "DECLARED"}}}}},
                    {"properties": {"sector_enriched_star_closure": {"properties": {"availability": {"const": "DECLARED"}}}}},
                    {"properties": {"lie_hall_carrier": {"properties": {"availability": {"const": "DECLARED"}}}}},
                    {"properties": {"deformation_chart": {"properties": {"availability": {"const": "DECLARED"}}}}}
                  ]
                }
              }
            }
          }
        }
      ],
