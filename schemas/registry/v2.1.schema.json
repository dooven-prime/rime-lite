        },
        "carrier_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "subject_object_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "value": {},
        "unit": {"type": ["string", "null"]},
        "result_state": {"$ref": "#/$defs/result_state"},
        "claim_status": {
          "anyOf": [
            {"$ref": "#/$defs/claim_status"},
            {"type": "null"}
          ]
        },
        "depth_registration": {"$ref": "#/$defs/depth_registration"},
        "repair_registration": {"$ref": "#/$defs/repair_registration"},
        "extraction_context": {"$ref": "#/$defs/extraction_context"},
        "semantic_convention_ids": {
          "type": "array",
