          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "certificate_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "artifact_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "qualification": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"comparison_scope": {"const": "single_channel"}},
            "required": ["comparison_scope"]
          },
          "then": {
            "properties": {
              "channel_ids": {"minItems": 1, "maxItems": 1},
              "carrier_ids": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"comparison_scope": {"const": "cross_channel"}},
            "required": ["comparison_scope"]
          },
          "then": {
            "properties": {
              "channel_ids": {"minItems": 2},
              "carrier_ids": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"comparison_scope": {"const": "unavailable"}},
            "required": ["comparison_scope"]
          },
          "then": {
            "properties": {
              "channel_ids": {"maxItems": 0},
              "carrier_ids": {"maxItems": 0},
              "result_state": {"enum": ["NOT_APPLICABLE", "NOT_DECLARED"]},
              "claim_status": {"type": "null"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
