    "dynamics": {
      "type": "object",
      "required": [
        "status",
        "description",
        "variables",
        "fixed_labels",
        "fixed_conventions",
        "continuity",
        "comparison_map_object_id",
        "trajectory_object_id",
        "semantic_convention_ids",
        "run_policy_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "static",
            "typed_deformation_chart",
            "analogue_trajectory",
            "schema_transition",
            "candidate_deformation",
            "historical_provenance"
          ]
        },
        "description": {"type": "string", "minLength": 1},
        "variables": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "fixed_labels": {"type": ["boolean", "null"]},
        "fixed_conventions": {"type": ["boolean", "null"]},
        "continuity": {"type": ["string", "null"]},
        "comparison_map_object_id": {
          "anyOf": [
            {"$ref": "#/$defs/id"},
            {"type": "null"}
          ]
        },
        "trajectory_object_id": {
          "anyOf": [
            {"$ref": "#/$defs/id"},
            {"type": "null"}
          ]
        },
        "semantic_convention_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "run_policy_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "typed_deformation_chart"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "fixed_labels": {"const": true},
              "fixed_conventions": {"const": true},
              "continuity": {"type": "string", "minLength": 1},
              "comparison_map_object_id": {"$ref": "#/$defs/id"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "analogue_trajectory"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "trajectory_object_id": {"$ref": "#/$defs/id"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "static"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "fixed_labels": {"const": null},
              "fixed_conventions": {"const": null},
              "continuity": {"const": null},
              "comparison_map_object_id": {"const": null},
              "trajectory_object_id": {"const": null}
            }
          }
        }
      ],
      "additionalProperties": false
    },
