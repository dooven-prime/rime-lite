      "type": "object",
      "required": ["id", "parameter_domain", "semantics", "run_policy_ids", "artifact_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "parameter_domain": {"type": "string", "minLength": 1},
        "semantics": {"type": "string", "minLength": 1},
