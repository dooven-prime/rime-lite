{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rime.example/schemas/sofaction/validation-receipt-v2.0.schema.json",
  "title": "SOFAction v2 Validation Receipt",
  "type": "object",
  "required": [
    "receipt_version",
    "artifact_type",
    "receipt_id",
    "action",
    "validator",
    "artifact_closure",
    "status",
    "checks",
    "negative_boundaries"
  ],
  "properties": {
    "receipt_version": {"const": "2.0"},
    "artifact_type": {"const": "sofaction_validation_receipt"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "action": {
      "type": "object",
      "required": ["action_record_id", "sofaction_version", "artifact"],
      "properties": {
        "action_record_id": {"$ref": "#/$defs/id"},
        "sofaction_version": {"const": "2.0"},
        "artifact": {"$ref": "#/$defs/artifact_reference"}
      },
      "additionalProperties": false
    },
    "validator": {
      "type": "object",
      "required": ["validator_id", "validator_version", "implementation", "receipt_contract"],
      "properties": {
        "validator_id": {"$ref": "#/$defs/id"},
        "validator_version": {"type": "string", "minLength": 1},
        "implementation": {"$ref": "#/$defs/artifact_reference"},
        "receipt_contract": {"$ref": "#/$defs/artifact_reference"}
      },
      "additionalProperties": false
    },
    "artifact_closure": {
      "type": "object",
      "required": ["artifact_count", "ordered_artifacts", "closure_digest"],
      "properties": {
        "artifact_count": {"type": "integer", "minimum": 1},
        "ordered_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "artifact"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "artifact": {"$ref": "#/$defs/artifact_reference"}
            },
            "additionalProperties": false
          }
        },
        "closure_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "status": {"const": "PASS"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["check_id", "status"],
        "properties": {
          "check_id": {
            "enum": [
              "action-context-policy-admission",
              "artifact-digest-closure",
              "audit-projection-preservation",
              "authorization-boundary",
              "candidate-set-regeneration",
              "disposition-closure",
              "predicate-replay",
              "schema-validation"
            ]
          },
          "status": {"const": "PASS"}
        },
        "additionalProperties": false
      }
    },
    "negative_boundaries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "digest": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "artifact_reference": {
      "type": "object",
      "required": [
        "uri",
        "digest"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
