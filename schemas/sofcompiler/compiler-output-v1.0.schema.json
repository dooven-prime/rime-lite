{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rime-project.local/schemas/sofcompiler/compiler-output-v1.0.schema.json",
  "title": "SOF Compiler Output v1.0",
  "description": "Typed output of Paper X Compile_v1. It is not a SOFRS report.",
  "type": "object",
  "required": [
    "compiler_output_version",
    "compiler_id",
    "manifest_id",
    "ir_record_id",
    "profile_id",
    "item_type",
    "items"
  ],
  "properties": {
    "compiler_output_version": {"const": "1.0"},
    "compiler_id": {"const": "sofcompiler.compile_v1"},
    "manifest_id": {"$ref": "#/$defs/id"},
    "ir_record_id": {"$ref": "#/$defs/id"},
    "profile_id": {"$ref": "#/$defs/id"},
    "item_type": {"const": "ClaimItem_v1 | DegradationItem_v1"},
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/claim_item"},
          {"$ref": "#/$defs/degradation_item"}
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "result_state": {
      "enum": [
        "DECLARED",
        "ESTABLISHED",
        "CERTIFIED",
        "OBSERVED",
        "UNREACHED_AT_CUTOFF",
        "NOT_APPLICABLE",
        "NOT_DECLARED"
      ]
    },
    "claim_status": {
      "enum": [
        "Theorem",
        "Computational Certificate",
        "Computational Observation",
        "Research Program",
        null
      ]
    },
    "claim_item": {
      "type": "object",
      "required": [
        "item_kind",
        "module_id",
        "claim_id",
        "source_ir_kind",
        "source_ir_id",
        "claim_status",
        "result_state",
        "carrier_ids",
        "derivation_ids"
      ],
      "properties": {
        "item_kind": {"const": "claim"},
        "module_id": {"$ref": "#/$defs/id"},
        "claim_id": {"$ref": "#/$defs/id"},
        "source_ir_kind": {"const": "claim"},
        "source_ir_id": {"$ref": "#/$defs/id"},
        "claim_status": {"$ref": "#/$defs/claim_status"},
        "result_state": {"$ref": "#/$defs/result_state"},
        "carrier_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "derivation_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "degradation_item": {
      "type": "object",
      "required": [
        "item_kind",
        "module_id",
        "action",
        "reason_kind",
        "details"
      ],
      "properties": {
        "item_kind": {"const": "degradation"},
        "module_id": {"$ref": "#/$defs/id"},
        "action": {
          "enum": [
            "fail_profile",
            "omit_module",
            "emit_unavailable",
            "omit_claim"
          ]
        },
        "reason_kind": {"type": "string", "minLength": 1},
        "source_ir_id": {"$ref": "#/$defs/id"},
        "details": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
