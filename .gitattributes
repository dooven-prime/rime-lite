# Keep source-addressed contracts, evidence, and implementations byte-stable.
.gitattributes text eol=lf
pyproject.toml text eol=lf
rime/**/*.py text eol=lf
registry/**/*.json text eol=lf
registry/**/*.py text eol=lf
schemas/**/*.json text eol=lf
schemas/**/*.py text eol=lf
experiments/**/*.json text eol=lf
experiments/**/*.md text eol=lf
experiments/**/*.py text eol=lf
experiments/**/*.sofaction text eol=lf
experiments/**/*.txt text eol=lf
papers/**/*.md text eol=lf
papers/tex/*.bib text eol=lf
experiments/**/*.lean text eol=lf
experiments/**/*.toml text eol=lf
experiments/**/lean-toolchain text eol=lf
# SOFAction v2.0 source digests bind the published Windows materialization.
# Preserve those root result files while keeping the v2.1 corpus canonical LF.
experiments/paper14/results/*.sofaction text eol=crlf
experiments/paper14/results/v2.1/**/*.sofaction text eol=lf
# SOFRS v2.0 receipts bind the published Windows materialization. Preserve
# that historical checkout contract while keeping the v2.1 revision canonical LF.
experiments/paper12/results/**/*.json text eol=crlf
experiments/paper12/results/v2.1/**/*.json text eol=lf
figures/**/*.py text eol=lf
tests/**/*.py text eol=lf
tests/**/*.json text eol=lf
tools/**/*.py text eol=lf
tools/**/*.md text eol=lf
