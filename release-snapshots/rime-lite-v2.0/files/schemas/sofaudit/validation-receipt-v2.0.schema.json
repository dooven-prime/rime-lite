{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rime.example/schemas/sofaudit/validation-receipt-v2.0.schema.json",
  "title": "SOFAUDIT v2 Validation Receipt",
  "type": "object",
  "required": [
    "receipt_version",
    "artifact_type",
    "receipt_id",
    "audit",
    "validator",
    "artifact_closure",
    "status",
    "checks",
    "negative_boundaries"
  ],
  "properties": {
    "receipt_version": { "const": "2.0" },
    "artifact_type": { "const": "sofaudit_validation_receipt" },
    "receipt_id": { "$ref": "#/$defs/id" },
    "audit": {
      "type": "object",
      "required": ["audit_id", "sofaudit_version", "artifact"],
      "properties": {
        "audit_id": { "$ref": "#/$defs/id" },
        "sofaudit_version": { "const": "2.0" },
        "artifact": { "$ref": "#/$defs/artifact_reference" }
      },
      "additionalProperties": false
    },
    "validator": {
      "type": "object",
      "required": ["validator_id", "validator_version", "implementation", "receipt_contract"],
      "properties": {
        "validator_id": { "$ref": "#/$defs/id" },
        "validator_version": { "type": "string", "minLength": 1 },
        "implementation": { "$ref": "#/$defs/artifact_reference" },
        "receipt_contract": { "$ref": "#/$defs/artifact_reference" }
      },
      "additionalProperties": false
    },
    "artifact_closure": {
      "type": "object",
      "required": ["artifact_count", "ordered_artifacts", "closure_digest"],
      "properties": {
        "artifact_count": { "type": "integer", "minimum": 1 },
        "ordered_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "artifact"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "artifact": { "$ref": "#/$defs/artifact_reference" }
            },
            "additionalProperties": false
          }
        },
        "closure_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "status": { "const": "PASS" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_id", "status"],
        "properties": {
          "check_id": {
            "enum": [
              "alignment-property-recomputation",
              "artifact-digest-closure",
              "claim-certificate-compatibility",
              "comparison-basis-recomputation",
              "guard-coordinate-coupling",
              "role-regime-profile-closure",
              "schema-validation",
              "source-report-receipt-validation"
            ]
          },
          "status": { "const": "PASS" }
        },
        "additionalProperties": false
      }
    },
    "negative_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "digest": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "artifact_reference": {
      "type": "object",
      "required": [
        "uri",
        "digest"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
